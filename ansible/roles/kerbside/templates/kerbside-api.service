{#
  gunicorn takes an IPv6 address in brackets, [::]:13002, so a bare one is
  bracketed here.
#}
{% set kerbside_api_bind = ('[' ~ kerbside_api_address ~ ']')
     if ':' in kerbside_api_address and not kerbside_api_address.startswith('[')
     else kerbside_api_address %}
# Kerbside's REST API, written by the shakenfist.kerbside kerbside role.
#
# Wanted by multi-user.target, and deliberately not by Shaken Fist's own
# target unit: on a host which is also a Shaken Fist node, the node role
# isolates that target, which keeps running every unit multi-user.target wants
# (the target requires multi-user.target) and stops every other.
[Unit]
Description=Kerbside VDI console proxy API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User={{ kerbside_user }}
Group={{ kerbside_group }}
WorkingDirectory={{ kerbside_state_dir }}

# The timeout matches sf-api's: an unknown signing key id makes Kerbside call
# Shaken Fist to refresh its keys inside the request.
# --no-control-socket because Kerbside does not use gunicornc, and gunicorn
# would otherwise try to create its socket under the root-owned home.
ExecStart={{ kerbside_venv }}/bin/gunicorn --bind {{ kerbside_api_bind }}:{{ kerbside_api_port }} --workers {{ kerbside_api_workers }} --timeout 300 --name kerbside-api --no-control-socket kerbside.api:app

# always rather than on-failure: Kerbside never exits on purpose, so any exit,
# clean or not, is one to restart from.
Restart=always
RestartSec=5

# Sandboxing. The API needs nothing beyond its own user: it writes nothing but
# gunicorn's worker heartbeat files and the CA files proxmox and ovirt sources
# write, and both go to a /tmp private to this unit. A LOG_OUTPUT_PATH file
# needs ReadWritePaths= in a drop-in; docs/deployment/manual.md says how.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
# AF_NETLINK because glibc's getaddrinfo() asks the kernel for this host's
# addresses over netlink when it resolves a hostname.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
# Not MemoryDenyWriteExecute=: libraries which build callbacks at run time
# with libffi fail under it, and which client libraries are installed depends
# on the sources configured.

[Install]
WantedBy=multi-user.target

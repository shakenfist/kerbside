{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitAuthor": "shakenfist-bot <bot@shakenfist.com>",
  "dependencyDashboard": true,
  "assignees": [
    "mikalstill"
  ],
  "schedule": [
    "after 9pm"
  ],
  "packageRules": [
    {
      "description": "Flag minor, patch, and digest updates for review (not auto-merged)",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": false
    },
    {
      "description": "Group pydantic updates together",
      "groupName": "pydantic",
      "matchPackageNames": [
        "/pydantic/"
      ]
    },
    {
      "description": "Group SQLAlchemy ecosystem updates together",
      "groupName": "sqlalchemy",
      "matchPackageNames": [
        "alembic",
        "sqlalchemy",
        "mysqlclient"
      ]
    },
    {
      "description": "Group the protobuf / gRPC ecosystem together. grpcio-tools pins protobuf to a compatible major, and the checked-in stubs in kerbside/rpc/ must be regenerated (tox -egenprotos) whenever protobuf moves, so these must bump as a coordinated set.",
      "groupName": "protobuf-grpc",
      "matchPackageNames": [
        "grpcio",
        "grpcio-tools",
        "protobuf",
        "mypy-protobuf"
      ]
    }
  ],
  "minimumReleaseAge": "3 days",
  "rollbackPrs": true
}

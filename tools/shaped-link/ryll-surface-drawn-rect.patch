+/// Build a `surface_drawn` event carrying the drawn rect as
+/// `[left, top, right, bottom]` in surface coordinates (local rect
+/// extension used by kerbside's shaped-link measurement).
+fn surface_drawn_event(
+    state: &ClientState,
+    display_channel_id: u8,
+    surface_id: u32,
+    produced_at_secs: f64,
+    rect: (u32, u32, u32, u32),
+) -> Option<Event> {
+    if !state.is_subscribed("surface_drawn") {
+        return None;
+    }
+    let wallclock_us = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_micros() as u64)
+        .unwrap_or(0);
+    Some(Event {
+        event: "surface_drawn".into(),
+        data: serde_json::json!({
+            "display_channel_id": display_channel_id,
+            "surface_id": surface_id,
+            "produced_at_secs": produced_at_secs,
+            "wallclock_us": wallclock_us,
+            "rect": [rect.0, rect.1, rect.2, rect.3],
+        }),
+    })
+}
